{
  "name": "net-car",
  "version": "0.1.0",
  "private": true,
  "description": "Net-CAR bilingual automotive telemetry platform",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=web",
    "build": "npm run build --workspace=web && node -e \"const fs=require('fs');if(fs.existsSync('web/.next/standalone/web')){if(fs.existsSync('web/.next/static'))fs.cpSync('web/.next/static','web/.next/standalone/web/.next/static',{recursive:true,force:true});if(fs.existsSync('web/public'))fs.cpSync('web/public','web/.next/standalone/web/public',{recursive:true,force:true});if(fs.existsSync('server.js'))fs.cpSync('server.js','web/.next/standalone/server.js',{force:true});}fs.rmSync('.next',{recursive:true,force:true});fs.cpSync('web/.next','.next',{recursive:true});\"",
    "start": "node -e \"const fs=require('fs'),p=require('path');if(fs.existsSync('server.js'))require(p.resolve('server.js'));else if(fs.existsSync('web/server.js')){process.chdir('web');require(p.resolve('server.js'));}\"",
    "lint": "npm run lint --workspace=web"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "firebase": "^13.2.0",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "postcss": "^8.5.32",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
