rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function parentUserExists(userId) {
      return exists(/databases/$(database)/documents/users/$(userId)) ||
             existsAfter(/databases/$(database)/documents/users/$(userId));
    }

    function parentVehicleExists(userId, vehicleId) {
      return exists(/databases/$(database)/documents/users/$(userId)/vehicles/$(vehicleId)) ||
             existsAfter(/databases/$(database)/documents/users/$(userId)/vehicles/$(vehicleId));
    }

    function isValidOptionalString(data, field, maxLen) {
      return !(field in data) || (data[field] is string && data[field].size() <= maxLen);
    }

    function isValidOptionalNumber(data, field, minVal) {
      return !(field in data) || (data[field] is number && data[field] >= minVal);
    }

    // 3. Validation Blueprints (Anti-Update-Gap)

    function isValidUserProfile(data, userId) {
      let requiredKeys = ['userId', 'name', 'email', 'preferredLang', 'units', 'currency', 'createdAt', 'updatedAt'];
      let allowedKeys = ['userId', 'name', 'email', 'preferredLang', 'units', 'currency', 'activeVehicleId', 'createdAt', 'updatedAt'];
      return data.keys().hasAll(requiredKeys) &&
             data.keys().hasOnly(allowedKeys) &&
             data.userId is string && data.userId == userId && data.userId.size() <= 128 &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 200 &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 320 &&
             data.preferredLang is string && data.preferredLang.size() <= 10 && data.preferredLang in ['en', 'fr'] &&
             data.units is string && data.units.size() <= 20 && data.units in ['metric', 'imperial'] &&
             data.currency is string && data.currency.size() <= 10 && data.currency in ['DZD', 'EUR', 'USD', 'CAD', 'GBP', 'MAD', 'CHF'] &&
             isValidOptionalString(data, 'activeVehicleId', 128) &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    function isValidVehicle(data, userId, vehicleId) {
      let requiredKeys = ['id', 'userId', 'make', 'model', 'year', 'fuelType', 'currentOdometer', 'createdAt', 'updatedAt'];
      let allowedKeys = ['id', 'userId', 'name', 'make', 'model', 'year', 'plate', 'vin', 'fuelType', 'photoUrl', 'currentOdometer', 'notes', 'createdAt', 'updatedAt'];
      return data.keys().hasAll(requiredKeys) &&
             data.keys().hasOnly(allowedKeys) &&
             data.id is string && data.id == vehicleId && data.id.size() <= 128 &&
             data.userId is string && data.userId == userId && data.userId.size() <= 128 &&
             isValidOptionalString(data, 'name', 100) &&
             data.make is string && data.make.size() >= 1 && data.make.size() <= 100 &&
             data.model is string && data.model.size() >= 1 && data.model.size() <= 100 &&
             data.year is number && data.year >= 1900 && data.year <= 2100 &&
             isValidOptionalString(data, 'plate', 30) &&
             isValidOptionalString(data, 'vin', 30) &&
             data.fuelType is string && data.fuelType.size() <= 30 && data.fuelType in ['gasoline', 'diesel', 'lpg', 'electric', 'hybrid', 'ethanol', 'cng'] &&
             isValidOptionalString(data, 'photoUrl', 2048) &&
             data.currentOdometer is number && data.currentOdometer >= 0 &&
             isValidOptionalString(data, 'notes', 5000) &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    function isValidFillUp(data, userId, fillupId) {
      let requiredKeys = ['id', 'userId', 'vehicleId', 'date', 'odometer', 'volume', 'pricePerUnit', 'totalCost', 'fuelType', 'isFullTank', 'createdAt', 'updatedAt'];
      let allowedKeys = ['id', 'userId', 'vehicleId', 'date', 'odometer', 'volume', 'pricePerUnit', 'totalCost', 'fuelType', 'isFullTank', 'station', 'notes', 'createdAt', 'updatedAt'];
      return data.keys().hasAll(requiredKeys) &&
             data.keys().hasOnly(allowedKeys) &&
             data.id is string && data.id == fillupId && data.id.size() <= 128 &&
             data.userId is string && data.userId == userId && data.userId.size() <= 128 &&
             isValidId(data.vehicleId) &&
             data.date is string && data.date.size() >= 1 && data.date.size() <= 64 &&
             data.odometer is number && data.odometer >= 0 &&
             data.volume is number && data.volume > 0 &&
             data.pricePerUnit is number && data.pricePerUnit >= 0 &&
             data.totalCost is number && data.totalCost >= 0 &&
             data.fuelType is string && data.fuelType.size() >= 1 && data.fuelType.size() <= 30 &&
             data.isFullTank is bool &&
             isValidOptionalString(data, 'station', 200) &&
             isValidOptionalString(data, 'notes', 5000) &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    function isValidExpense(data, userId, expenseId) {
      let requiredKeys = ['id', 'userId', 'vehicleId', 'date', 'category', 'amount', 'description', 'createdAt', 'updatedAt'];
      let allowedKeys = ['id', 'userId', 'vehicleId', 'date', 'category', 'amount', 'description', 'receiptUrl', 'odometer', 'notes', 'createdAt', 'updatedAt'];
      return data.keys().hasAll(requiredKeys) &&
             data.keys().hasOnly(allowedKeys) &&
             data.id is string && data.id == expenseId && data.id.size() <= 128 &&
             data.userId is string && data.userId == userId && data.userId.size() <= 128 &&
             isValidId(data.vehicleId) &&
             data.date is string && data.date.size() >= 1 && data.date.size() <= 64 &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 100 &&
             data.amount is number && data.amount > 0 &&
             data.description is string && data.description.size() >= 1 && data.description.size() <= 500 &&
             isValidOptionalString(data, 'receiptUrl', 2048) &&
             isValidOptionalNumber(data, 'odometer', 0) &&
             isValidOptionalString(data, 'notes', 5000) &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    function isValidPartsList(data) {
      return !('parts' in data) || (
        data.parts is list &&
        data.parts.size() <= 50 &&
        (data.parts.size() == 0 || (data.parts[0] is string && data.parts[0].size() <= 200))
      );
    }

    function isValidService(data, userId, serviceId) {
      let requiredKeys = ['id', 'userId', 'vehicleId', 'date', 'type', 'odometer', 'cost', 'description', 'createdAt', 'updatedAt'];
      let allowedKeys = ['id', 'userId', 'vehicleId', 'date', 'type', 'odometer', 'cost', 'description', 'parts', 'receiptUrl', 'notes', 'createdAt', 'updatedAt'];
      return data.keys().hasAll(requiredKeys) &&
             data.keys().hasOnly(allowedKeys) &&
             data.id is string && data.id == serviceId && data.id.size() <= 128 &&
             data.userId is string && data.userId == userId && data.userId.size() <= 128 &&
             isValidId(data.vehicleId) &&
             data.date is string && data.date.size() >= 1 && data.date.size() <= 64 &&
             data.type is string && data.type.size() >= 1 && data.type.size() <= 100 &&
             data.odometer is number && data.odometer >= 0 &&
             data.cost is number && data.cost >= 0 &&
             data.description is string && data.description.size() >= 1 && data.description.size() <= 500 &&
             isValidPartsList(data) &&
             isValidOptionalString(data, 'receiptUrl', 2048) &&
             isValidOptionalString(data, 'notes', 5000) &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    function isValidReminder(data, userId, reminderId) {
      let requiredKeys = ['id', 'userId', 'vehicleId', 'type', 'isRecurring', 'isActive', 'createdAt', 'updatedAt'];
      let allowedKeys = ['id', 'userId', 'vehicleId', 'type', 'title', 'intervalKm', 'intervalDays', 'lastServiceDate', 'lastServiceOdometer', 'nextDueDate', 'nextDueOdometer', 'isRecurring', 'isActive', 'createdAt', 'updatedAt'];
      return data.keys().hasAll(requiredKeys) &&
             data.keys().hasOnly(allowedKeys) &&
             data.id is string && data.id == reminderId && data.id.size() <= 128 &&
             data.userId is string && data.userId == userId && data.userId.size() <= 128 &&
             isValidId(data.vehicleId) &&
             data.type is string && data.type.size() >= 1 && data.type.size() <= 100 &&
             isValidOptionalString(data, 'title', 200) &&
             isValidOptionalNumber(data, 'intervalKm', 0) &&
             isValidOptionalNumber(data, 'intervalDays', 0) &&
             isValidOptionalString(data, 'lastServiceDate', 64) &&
             isValidOptionalNumber(data, 'lastServiceOdometer', 0) &&
             isValidOptionalString(data, 'nextDueDate', 64) &&
             isValidOptionalNumber(data, 'nextDueOdometer', 0) &&
             data.isRecurring is bool &&
             data.isActive is bool &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    // 4. Collection Rules (Denial of Wallet Order: Auth -> Static Validation -> Relational DB Checks)

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming(), userId) &&
                       incoming().createdAt == request.time &&
                       incoming().updatedAt == request.time;

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       (incoming().createdAt == existing().createdAt || incoming().createdAt == request.time) &&
                       incoming().updatedAt == request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['name', 'email', 'preferredLang', 'units', 'currency', 'activeVehicleId', 'createdAt', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(userId);

      match /vehicles/{vehicleId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(vehicleId) && parentUserExists(userId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;

        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(vehicleId) &&
                         isValidVehicle(incoming(), userId, vehicleId) &&
                         incoming().createdAt == request.time &&
                         incoming().updatedAt == request.time &&
                         parentUserExists(userId);

        allow update: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(vehicleId) &&
                         isValidVehicle(incoming(), userId, vehicleId) &&
                         incoming().id == existing().id &&
                         incoming().userId == existing().userId &&
                         (incoming().createdAt == existing().createdAt || incoming().createdAt == request.time) &&
                         incoming().updatedAt == request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['name', 'make', 'model', 'year', 'plate', 'vin', 'fuelType', 'photoUrl', 'currentOdometer', 'notes', 'createdAt', 'updatedAt']) &&
                         parentUserExists(userId);

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(vehicleId) && parentUserExists(userId);
      }

      match /fillups/{fillupId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(fillupId) && parentUserExists(userId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;

        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(fillupId) &&
                         isValidFillUp(incoming(), userId, fillupId) &&
                         incoming().createdAt == request.time &&
                         incoming().updatedAt == request.time &&
                         parentUserExists(userId) &&
                         parentVehicleExists(userId, incoming().vehicleId);

        allow update: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(fillupId) &&
                         isValidFillUp(incoming(), userId, fillupId) &&
                         incoming().id == existing().id &&
                         incoming().userId == existing().userId &&
                         incoming().vehicleId == existing().vehicleId &&
                         (incoming().createdAt == existing().createdAt || incoming().createdAt == request.time) &&
                         incoming().updatedAt == request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['date', 'odometer', 'volume', 'pricePerUnit', 'totalCost', 'fuelType', 'isFullTank', 'station', 'notes', 'createdAt', 'updatedAt']) &&
                         parentUserExists(userId);

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(fillupId) && parentUserExists(userId);
      }

      match /expenses/{expenseId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(expenseId) && parentUserExists(userId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;

        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(expenseId) &&
                         isValidExpense(incoming(), userId, expenseId) &&
                         incoming().createdAt == request.time &&
                         incoming().updatedAt == request.time &&
                         parentUserExists(userId) &&
                         parentVehicleExists(userId, incoming().vehicleId);

        allow update: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(expenseId) &&
                         isValidExpense(incoming(), userId, expenseId) &&
                         incoming().id == existing().id &&
                         incoming().userId == existing().userId &&
                         incoming().vehicleId == existing().vehicleId &&
                         (incoming().createdAt == existing().createdAt || incoming().createdAt == request.time) &&
                         incoming().updatedAt == request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['date', 'category', 'amount', 'description', 'receiptUrl', 'odometer', 'notes', 'createdAt', 'updatedAt']) &&
                         parentUserExists(userId);

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(expenseId) && parentUserExists(userId);
      }

      match /services/{serviceId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(serviceId) && parentUserExists(userId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;

        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(serviceId) &&
                         isValidService(incoming(), userId, serviceId) &&
                         incoming().createdAt == request.time &&
                         incoming().updatedAt == request.time &&
                         parentUserExists(userId) &&
                         parentVehicleExists(userId, incoming().vehicleId);

        allow update: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(serviceId) &&
                         isValidService(incoming(), userId, serviceId) &&
                         incoming().id == existing().id &&
                         incoming().userId == existing().userId &&
                         incoming().vehicleId == existing().vehicleId &&
                         (incoming().createdAt == existing().createdAt || incoming().createdAt == request.time) &&
                         incoming().updatedAt == request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['date', 'type', 'odometer', 'cost', 'description', 'parts', 'receiptUrl', 'notes', 'createdAt', 'updatedAt']) &&
                         parentUserExists(userId);

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(serviceId) && parentUserExists(userId);
      }

      match /reminders/{reminderId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(reminderId) && parentUserExists(userId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;

        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(reminderId) &&
                         isValidReminder(incoming(), userId, reminderId) &&
                         incoming().createdAt == request.time &&
                         incoming().updatedAt == request.time &&
                         parentUserExists(userId) &&
                         parentVehicleExists(userId, incoming().vehicleId);

        allow update: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(reminderId) &&
                         isValidReminder(incoming(), userId, reminderId) &&
                         incoming().id == existing().id &&
                         incoming().userId == existing().userId &&
                         incoming().vehicleId == existing().vehicleId &&
                         (incoming().createdAt == existing().createdAt || incoming().createdAt == request.time) &&
                         incoming().updatedAt == request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['type', 'title', 'intervalKm', 'intervalDays', 'lastServiceDate', 'lastServiceOdometer', 'nextDueDate', 'nextDueOdometer', 'isRecurring', 'isActive', 'createdAt', 'updatedAt']) &&
                         parentUserExists(userId);

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(reminderId) && parentUserExists(userId);
      }
    }
  }
}
